      "walk_right": { "file": "sprites/hero/hero.png", "frameWidth": 26, "frameHeight": 37, "row": 2, "frames": 3, "frameOrder": [0, 1, 2, 1], "fps": 8 },
      "idle_up": { "file": "sprites/hero/hero.png", "frameWidth": 26, "frameHeight": 37, "row": 3, "frames": 1, "fps": 1 },
      "walk_up": { "file": "sprites/hero/hero.png", "frameWidth": 26, "frameHeight": 37, "row": 3, "frames": 3, "frameOrder": [0, 1, 2, 1], "fps": 8 }
